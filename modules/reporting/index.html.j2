<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Homelab reports</title>
<style>
  table, th, td {
    box-sizing: border-box;
  }
  body {
    font-family: -apple-system, "Segoe UI", Roboto, sans-serif;
    max-width: 760px;
    margin: auto;
    padding: 12px;
    color: #222;
    background: #fff;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  table {
    table-layout: fixed;
    border-collapse: collapse;
    width: 100%;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }
  th {
    text-align: left;
    padding: 5px 8px;
    border-bottom: 2px solid #ccc;
    background: #f6f6f6;
    font-weight: 600;
  }
  td { padding: 4px 8px; border-bottom: 1px solid #eee; }
  td.report { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  @media (max-width: 480px) {
    body { padding: 8px; }
    table { font-size: 13px; }
    th, td { padding: 4px 6px; }
  }
</style>
</head>
<body>
<h2>Homelab reports</h2>
<p><a href="latest.html">→ Latest report</a></p>
<table>
<tr>
  <th>Date</th>
  <th>Status</th>
  <th>Report</th>
</tr>
{% for r in reports %}
<tr>
  <td>{{ r.time }}</td>
  <td{% if r.color %} style="color:{{ r.color }};font-weight:600"{% endif %}>{{ r.status }}</td>
  <td class="report"><a href="{{ r.name }}">{{ r.name }}</a></td>
</tr>
{% endfor %}
</table>
</body>
</html>
